<svg width="520" height="520" viewBox="0 0 520 520" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="520" height="520" fill="#0B0F17"/>
  
  <!-- Main brain circle -->
  <circle cx="260" cy="180" r="140" fill="#00E5C4" opacity="0.95"/>
  
  <!-- Brain texture (simplified with circles) -->
  <circle cx="220" cy="140" r="25" fill="#00D9FF" opacity="0.8"/>
  <circle cx="260" cy="130" r="30" fill="#00E5C4" opacity="0.9"/>
  <circle cx="300" cy="140" r="25" fill="#00D9FF" opacity="0.8"/>
  <circle cx="240" cy="180" r="28" fill="#00E5C4" opacity="0.85"/>
  <circle cx="280" cy="180" r="28" fill="#00D9FF" opacity="0.85"/>
  <circle cx="220" cy="220" r="22" fill="#00D9FF" opacity="0.7"/>
  <circle cx="300" cy="220" r="22" fill="#00D9FF" opacity="0.7"/>
  
  <!-- Eyes/Glasses -->
  <rect x="210" y="180" width="45" height="35" rx="5" fill="#1a1a1a" stroke="#00D9FF" stroke-width="2"/>
  <rect x="265" y="180" width="45" height="35" rx="5" fill="#1a1a1a" stroke="#00D9FF" stroke-width="2"/>
  <circle cx="232" cy="197" r="12" fill="#00E5C4" opacity="0.6"/>
  <circle cx="287" cy="197" r="12" fill="#00E5C4" opacity="0.6"/>
  
  <!-- Nose bridge -->
  <rect x="255" y="188" width="10" height="20" fill="#00D9FF" opacity="0.5"/>
  
  <!-- Smile -->
  <path d="M 230 220 Q 260 240 290 220" stroke="#00E5C4" stroke-width="3" fill="none" stroke-linecap="round"/>
  
  <!-- Left arm -->
  <ellipse cx="150" cy="240" rx="35" ry="50" fill="#00D9FF" opacity="0.7" transform="rotate(-25 150 240)"/>
  
  <!-- Right arm -->
  <ellipse cx="370" cy="240" rx="35" ry="50" fill="#00D9FF" opacity="0.7" transform="rotate(25 370 240)"/>
  
  <!-- Left hand peace sign -->
  <circle cx="130" cy="300" r="20" fill="#00E5C4" opacity="0.8"/>
  <circle cx="125" cy="265" r="12" fill="#00D9FF" opacity="0.7"/>
  <circle cx="145" cy="265" r="12" fill="#00D9FF" opacity="0.7"/>
  
  <!-- Right hand thumbs up -->
  <circle cx="390" cy="300" r="20" fill="#00E5C4" opacity="0.8"/>
  
  <!-- Glow effect -->
  <circle cx="260" cy="180" r="160" fill="none" stroke="#00E5C4" stroke-width="2" opacity="0.3"/>
  
  <!-- Decorative dots around -->
  <circle cx="100" cy="80" r="6" fill="#00D9FF" opacity="0.4"/>
  <circle cx="420" cy="100" r="5" fill="#00E5C4" opacity="0.5"/>
  <circle cx="440" cy="280" r="7" fill="#00D9FF" opacity="0.3"/>
  <circle cx="80" cy="300" r="4" fill="#00E5C4" opacity="0.4"/>
  <circle cx="450" cy="450" r="6" fill="#00D9FF" opacity="0.35"/>
  <circle cx="70" cy="420" r="5" fill="#00E5C4" opacity="0.3"/>
</svg>